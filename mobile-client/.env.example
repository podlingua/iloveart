# Same Supabase project as the main website (app/.env.example) - the
# bundled client authenticates directly against Supabase, then sends the
# resulting access token as a bearer token to the API below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute origin of the deployed Next.js API (the existing website). This
# origin must be present in the API's server-side ALLOWED_ORIGINS env var,
# and once wrapped in Capacitor, the app's iOS origin (e.g. capacitor://localhost
# or https://localhost, depending on server.iosScheme) must be added there too.
# Leave empty only for a same-origin dev setup; required in production.
VITE_API_BASE_URL=https://your-deployed-site.example.com
