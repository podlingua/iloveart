# OpenAI API key, used server-side by /api/transcribe, /api/analyze, /api/compare.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase project credentials. Optional: without these, the app still works
# but sessions/recordings/transcripts/analyses are not persisted and there is
# no auth or history. Create a project at https://supabase.com/dashboard,
# then run the migration in supabase/migrations/0001_init.sql against it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
