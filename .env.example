# OpenAI API key, used server-side by /api/transcribe, /api/analyze, /api/compare.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase project credentials (public, safe to expose to the browser).
# NOTE: as of the API security hardening, these are no longer optional -
# /api/transcribe, /api/analyze, /api/compare, /api/fact-check, and
# /api/extract-source all require a verified Supabase session and will
# reject every request with 401 if Supabase isn't configured. Create a
# project at https://supabase.com/dashboard, then run the migrations in
# supabase/migrations/ against it (in order).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by app/api/delete-account to remove a user's
# auth account, database rows, and storage files. NEVER prefix this with
# NEXT_PUBLIC_ or VITE_, and never send it to any client - it bypasses Row
# Level Security entirely. Find it in Supabase: Project Settings -> API ->
# service_role key ("secret", not the "anon"/"public" key).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Comma-separated list of exact origins allowed to call the API
# routes cross-origin (CORS), e.g.:
#   https://your-deployed-site.vercel.app,capacitor://localhost
# Localhost dev origins (http://localhost:3000, capacitor://localhost,
# https://localhost, etc.) are always allowed automatically outside of
# production (NODE_ENV !== "production"), so you don't need to list them
# here for local development. In production, only origins listed here (plus
# same-origin requests, which don't send an Origin header) are allowed.
ALLOWED_ORIGINS=

# Optional. Configure these to enable a real, persistent, cross-instance rate
# limit store (recommended for production - see lib/security/rateLimit.ts).
# Without them, the app falls back to an in-memory limiter that is NOT
# reliable across Vercel's serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
